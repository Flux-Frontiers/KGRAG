{
  "mcpServers": {
    "kgrag": {
      "command": "kgrag",
      "args": ["mcp"]
    },
    "pycodekg": {
      "command": "pycodekg",
      "args": ["mcp", "--repo", "."]
    },
    "dockg": {
      "command": "dockg",
      "args": ["mcp", "--repo", "."]
    },
    "memorykg": {
      "command": "memorykg",
      "args": ["mcp", "--repo", ".memorykg"]
    },
    "agentkg": {
      "command": "agentkg",
      "args": ["mcp"],
      "env": {
        "AGENTKG_REPO": ".",
        "AGENTKG_PERSON": "egs"
      }
    },
    "metabokg": {
      "command": "metabokg",
      "args": ["mcp", "--repo", "../Metabo_kg", "--db", ".metabokg/meta.sqlite"]
    }
  }
}
